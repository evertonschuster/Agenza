{
  "name": "admin-monorepo",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=26.5.1"
  },
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace=apps/admin-frontend",
    "build:frontend": "npm run build --workspace=apps/admin-frontend",
    "test:frontend": "npm run test --workspace=apps/admin-frontend",
    "lint:frontend": "npm run lint --workspace=apps/admin-frontend"
  },
  "allowScripts": {
    "msw": true,
    "esbuild@0.28.2": true
  }
}
