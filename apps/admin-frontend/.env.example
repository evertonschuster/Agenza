# All six variables below are injected automatically by Aspire's AddViteApp
# resource (backend/AppHost/AppHost.cs) when running via the orchestrator.
# This file documents them for reference only — do not hardcode fallback
# values in application code (see specs/001-oidc-shell-scaffold/contracts/env-contract.md).

VITE_API_BASE_URL=http://localhost:5080
VITE_OIDC_AUTHORITY=http://localhost:5081
VITE_OIDC_CLIENT_ID=admin-panel
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_SCOPE=openid profile tenant_id services-api offline_access
