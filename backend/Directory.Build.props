<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    xUnit v3 test projects (*.Tests, *.PersistenceTests) are executables.
    xUnit1051 is off: the suites run in memory in milliseconds, so threading
    TestContext.Current.CancellationToken through every call buys nothing
    (docs/adr/0050).
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <!--
    Coverage gate for unit-test projects (*.Tests): coverlet instruments
    the assemblies each test project references (Domain + Application)
    and fails `dotnet test` below 80% line coverage. Lives here instead
    of CI flags so local `dotnet test` enforces the same gate.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <CollectCoverage>true</CollectCoverage>
    <Threshold>80</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>
</Project>
