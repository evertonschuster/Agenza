<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced by hosts only (ServiceDefaults, AppHost), never by Domain or
         Application, so the ASP.NET Core dependency for request logging stays
         out of the layers (docs/adr/0018, docs/adr/0054). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Expressions" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Admin.Logging.Tests" />
  </ItemGroup>

</Project>
