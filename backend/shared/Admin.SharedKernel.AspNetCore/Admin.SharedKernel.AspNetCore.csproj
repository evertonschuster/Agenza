<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Admin.SharedKernel\Admin.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the Result -> IActionResult mapping, the invalid-model-state
         mapping and the generic exception handler live here - all need
         MVC/hosting types. Everything else
         (Result, Error, Cqrs, Dispatcher) stays framework-agnostic in
         Admin.SharedKernel (docs/adr/0018). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The OpenAPI schema of the value objects (Admin.SharedKernel.ValueObjects): one string each. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Admin.SharedKernel.ValueObjects" />
  </ItemGroup>

</Project>
