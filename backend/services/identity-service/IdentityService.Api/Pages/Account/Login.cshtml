@page
@model IdentityService.Api.Pages.Account.LoginModel
<!DOCTYPE html>
<html lang="pt-BR" data-theme="@Model.Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f6f8" />
    <title>Entrar | Receptionist AI</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <script src="~/js/login.js" asp-append-version="true" defer></script>
</head>
<body>
    <main class="login-shell">
        <section class="brand-panel" aria-labelledby="brand-heading">
            <div class="brand-panel__glow" aria-hidden="true"></div>

            <div class="brand">
                <span class="brand__mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32" role="img">
                        <path d="M9 10.5A4.5 4.5 0 0 1 13.5 6h5A4.5 4.5 0 0 1 23 10.5v7a4.5 4.5 0 0 1-4.5 4.5H16l-4.8 4v-4.35A4.5 4.5 0 0 1 9 17.5v-7Z" />
                        <path d="m16 10 .8 2.2L19 13l-2.2.8L16 16l-.8-2.2L13 13l2.2-.8L16 10Z" />
                    </svg>
                </span>
                <span>Receptionist AI</span>
            </div>

            <div class="brand-panel__content">
                <p class="eyebrow">Gestão simples. Atendimento melhor.</p>
                <h1 id="brand-heading">Tudo o que sua operação precisa, em um só lugar.</h1>
                <p class="brand-panel__description">
                    Organize sua agenda, seus serviços e o relacionamento com clientes
                    em uma experiência feita para o seu dia a dia.
                </p>

                <ul class="feature-list" aria-label="Benefícios da plataforma">
                    <li>
                        <span class="feature-list__icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20">
                                <path d="M5.5 2.5v3m9-3v3M3 8h14M5 4h10a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                                <path d="m7 12 2 2 4-4" />
                            </svg>
                        </span>
                        <span>Rotina e agenda sempre organizadas</span>
                    </li>
                    <li>
                        <span class="feature-list__icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20">
                                <path d="M10 17a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z" />
                                <path d="M10 6v4l2.5 1.5" />
                            </svg>
                        </span>
                        <span>Mais tempo para cuidar de cada cliente</span>
                    </li>
                </ul>
            </div>

            <p class="brand-panel__footer">Uma plataforma Agenza</p>
        </section>

        <section class="login-panel" aria-labelledby="login-heading">
            <button
                class="theme-toggle"
                type="button"
                aria-label="Alternar tema"
                title="Alternar tema"
                data-theme-toggle>
                <svg class="theme-toggle__moon" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M16.5 12.2A6.7 6.7 0 0 1 7.8 3.5 6.7 6.7 0 1 0 16.5 12.2Z" />
                </svg>
                <svg class="theme-toggle__sun" viewBox="0 0 20 20" aria-hidden="true">
                    <circle cx="10" cy="10" r="3" />
                    <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M15.7 4.3l-1.4 1.4M5.7 14.3l-1.4 1.4" />
                </svg>
            </button>

            <div class="login-card">
                <div class="mobile-brand">
                    <span class="brand__mark">
                        <svg viewBox="0 0 32 32">
                            <path d="M9 10.5A4.5 4.5 0 0 1 13.5 6h5A4.5 4.5 0 0 1 23 10.5v7a4.5 4.5 0 0 1-4.5 4.5H16l-4.8 4v-4.35A4.5 4.5 0 0 1 9 17.5v-7Z" />
                            <path d="m16 10 .8 2.2L19 13l-2.2.8L16 16l-.8-2.2L13 13l2.2-.8L16 10Z" />
                        </svg>
                    </span>
                    <span>Receptionist AI</span>
                </div>

                <header class="login-card__header">
                    <p class="eyebrow">Área administrativa</p>
                    <h2 id="login-heading">Que bom ter você de volta</h2>
                    <p>Use suas credenciais para acessar sua conta.</p>
                </header>

                @if (Model.ErrorMessage is not null)
                {
                    <div class="alert" role="alert">
                        <span class="alert__icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20">
                                <path d="M10 17a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z" />
                                <path d="M10 6.5v4M10 13.5h.01" />
                            </svg>
                        </span>
                        <div>
                            <strong>@Model.ErrorTitle</strong>
                            <p>@Model.ErrorMessage</p>
                            <div class="alert__support">
                                <span>Código para solicitar ajuda</span>
                                <code>@Model.ErrorCode</code>
                                <small>Informe este código e o horário da tentativa. Nunca compartilhe sua senha.</small>
                            </div>
                        </div>
                    </div>
                }

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-login-form>
                    <div class="field">
                        <label asp-for="Email">E-mail</label>
                        <div class="field__control">
                            <span class="field__icon" aria-hidden="true">
                                <svg viewBox="0 0 20 20">
                                    <path d="M3 5.5A1.5 1.5 0 0 1 4.5 4h11A1.5 1.5 0 0 1 17 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 14.5v-9Z" />
                                    <path d="m4 6 6 4.5L16 6" />
                                </svg>
                            </span>
                            <input
                                asp-for="Email"
                                type="email"
                                inputmode="email"
                                autocomplete="username"
                                placeholder="voce@empresa.com"
                                required
                                autofocus />
                        </div>
                    </div>

                    <div class="field">
                        <label asp-for="Password">Senha</label>
                        <div class="field__control">
                            <span class="field__icon" aria-hidden="true">
                                <svg viewBox="0 0 20 20">
                                    <rect x="4" y="8" width="12" height="9" rx="2" />
                                    <path d="M7 8V6a3 3 0 0 1 6 0v2M10 12v2" />
                                </svg>
                            </span>
                            <input
                                asp-for="Password"
                                type="password"
                                autocomplete="current-password"
                                placeholder="Digite sua senha"
                                required
                                data-password-input />
                            <button
                                class="password-toggle"
                                type="button"
                                aria-label="Mostrar senha"
                                aria-pressed="false"
                                data-password-toggle>
                                <svg viewBox="0 0 20 20" aria-hidden="true">
                                    <path d="M2.5 10s2.7-4.5 7.5-4.5 7.5 4.5 7.5 4.5-2.7 4.5-7.5 4.5S2.5 10 2.5 10Z" />
                                    <circle cx="10" cy="10" r="2" />
                                    <path class="password-toggle__slash" d="m4 4 12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button class="submit-button" type="submit" data-submit-button>
                        <span class="submit-button__label">Entrar</span>
                        <span class="submit-button__spinner" aria-hidden="true"></span>
                        <svg class="submit-button__arrow" viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M4 10h12M12 6l4 4-4 4" />
                        </svg>
                    </button>
                </form>

                <div class="security-note">
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M10 2.5 16 5v4.5c0 3.7-2.5 6.5-6 8-3.5-1.5-6-4.3-6-8V5l6-2.5Z" />
                        <path d="m7.5 10 1.5 1.5 3.5-3.5" />
                    </svg>
                    <span>Seus dados são protegidos e criptografados.</span>
                </div>
            </div>

            <p class="login-panel__footer">
                Se o acesso falhar, a tela mostrará o motivo, o próximo passo e um código para acompanhar a solicitação.
            </p>
        </section>
    </main>
</body>
</html>
