{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=appdb;Username=identity_app;Password=postgres"
  },
  "DatabaseBootstrap": {
    "RunOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5080",
      "http://localhost:5081"
    ]
  },
  "Identity": {
    "PublicIssuer": "https://localhost:7081/"
  },
  "DemoTenant": {
    "Name": "Demo Business",
    "OwnerEmail": "owner@demo.local",
    "OwnerPassword": "Passw0rd!"
  },
  "OAuth": {
    "Scopes": [
      {
        "Name": "openid",
        "DisplayName": "openid"
      },
      {
        "Name": "profile",
        "DisplayName": "profile"
      },
      {
        "Name": "email",
        "DisplayName": "email"
      },
      {
        "Name": "offline_access",
        "DisplayName": "offline_access"
      },
      {
        "Name": "tenant_id",
        "DisplayName": "tenant_id"
      },
      {
        "Name": "services-api",
        "DisplayName": "API de serviços",
        "Resources": [
          "services-api"
        ]
      },
      {
        "Name": "identity-admin",
        "DisplayName": "Administração de identidade",
        "Resources": [
          "identity-service"
        ]
      },
      {
        "Name": "mcp:connect",
        "DisplayName": "Acesso ao recurso de ferramentas",
        "Resources": [
          "https://localhost:7091/mcp"
        ]
      }
    ],
    "Clients": [
      {
        "ClientId": "admin-panel",
        "DisplayName": "Painel administrativo",
        "ClientType": "public",
        "ApplicationType": "web",
        "ConsentType": "implicit",
        "GrantTypes": [
          "authorization_code",
          "refresh_token"
        ],
        "Scopes": [
          "openid",
          "profile",
          "email",
          "offline_access",
          "tenant_id",
          "services-api"
        ],
        "Resources": [
          "services-api"
        ],
        "RedirectUris": [
          "http://localhost:5173/callback",
          "http://localhost:5080/api-docs/",
          "http://localhost:5081/api-docs/"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:5173/login"
        ]
      },
      {
        "ClientId": "agenza-mcp",
        "AllowAnyLoopbackRedirectPath": true,
        "DisplayName": "Agenza MCP",
        "ClientType": "public",
        "ApplicationType": "native",
        "ConsentType": "implicit",
        "GrantTypes": [
          "authorization_code",
          "refresh_token"
        ],
        "Scopes": [
          "openid",
          "profile",
          "tenant_id",
          "mcp:connect",
          "offline_access"
        ],
        "Resources": [
          "https://localhost:7091/mcp"
        ],
        "RedirectUris": [
          "http://127.0.0.1/callback/w0rLwdQGb9n5",
          "http://127.0.0.1/oauth/callback",
          "http://127.0.0.1/",
          "https://vscode.dev/redirect"
        ]
      },
      {
        "ClientId": "assistant-service-worker",
        "DisplayName": "Serviço de assistente",
        "ClientType": "confidential",
        "GrantTypes": [
          "client_credentials"
        ],
        "Scopes": [
          "services-api"
        ],
        "Resources": [
          "services-api"
        ],
        "SecretConfigurationKey": "OAuthClientSecrets:assistant-service-worker"
      },
      {
        "ClientId": "tenant-provisioning-cli",
        "DisplayName": "Provisionamento de negócios",
        "ClientType": "confidential",
        "GrantTypes": [
          "client_credentials"
        ],
        "Scopes": [
          "identity-admin"
        ],
        "Resources": [
          "identity-service"
        ],
        "SecretConfigurationKey": "OAuthClientSecrets:tenant-provisioning-cli"
      }
    ]
  },
  "OAuthClientSecrets": {
    "assistant-service-worker": "postgres",
    "tenant-provisioning-cli": "postgres"
  }
}
